# ── Server ────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────
# Leave blank in dev (all origins allowed).
# In production set to your Firebase Hosting URL, e.g.:
#   ALLOWED_ORIGIN=https://your-project.web.app
ALLOWED_ORIGIN=

# ── Admin bootstrap ────────────────────────────────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=

# ── GitHub Actions relay ───────────────────────────────────────────────────
# Shared secret used by POST /api/import/draw.
# Must match the IMPORT_API_KEY secret set in the GitHub repo.
# Generate with: openssl rand -hex 32
# IMPORT_API_KEY=

# ── Firebase / Firestore credentials ──────────────────────────────────────
#
# OPTION A — Local dev (file path):
#   1. Firebase Console → Project Settings → Service Accounts
#      → Generate new private key → save as server/serviceAccountKey.json
#   2. Set the path below and restart
#
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
#
# OPTION B — Production (Render / Railway / any PaaS):
#   Paste the entire contents of your serviceAccountKey.json as a single
#   JSON string into the FIREBASE_SERVICE_ACCOUNT_JSON env var.
#   In the Render dashboard: Environment → Add variable → paste raw JSON.
#   Do NOT set GOOGLE_APPLICATION_CREDENTIALS when using this option.
#
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# ── Telegram Notifications ────────────────────────────────────────────────
#
# To enable automatic group notifications after every pipeline run:
#
#   1. Create a bot via @BotFather on Telegram → copy the token below
#   2. Add the bot to your group chat as an admin
#   3. Find your group chat ID:
#      a. Send a message to the group
#      b. Visit: https://api.telegram.org/bot{TOKEN}/getUpdates
#      c. Look for "chat":{"id": -XXXXXXXXX}  (negative number = group)
#   4. Set both vars below and restart the server
#
# TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeff...
# TELEGRAM_CHAT_ID=-1001234567890
#
# Leave commented out to disable Telegram notifications entirely.
#
# ── Recommended Firestore indexes ─────────────────────────────────────────
#   Collection: draws
#   ├── Single field:  drawId  (Descending)
#   ├── Composite:     year ASC + month ASC
#   └── Single field:  dayOfWeek (Ascending)
#
#   Collection: notification_logs
#   └── Composite: channel ASC + drawId ASC + success ASC  ← idempotency check
